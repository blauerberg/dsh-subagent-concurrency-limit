{
  "name": "dsh-subagent-concurrency-limit",
  "version": "0.1.0",
  "description": "Limit concurrent DeepSeek Harness subagent turns and delegation runs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blauerberg/dsh-subagent-concurrency-limit.git"
  },
  "homepage": "https://github.com/blauerberg/dsh-subagent-concurrency-limit#readme",
  "bugs": {
    "url": "https://github.com/blauerberg/dsh-subagent-concurrency-limit/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "concurrency"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "biome format --write",
    "lint": "biome ci",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.spec.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=11.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.22.0"
}
